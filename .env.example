# ============================================================================
# LocalMind-RAG Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ============================================================================

# ── LLM Backend Selection ───────────────────────────────────────────────────
# Primary backend: ollama (local, fully private) or groq (cloud fallback)
LLM_BACKEND=ollama

# ── Ollama Local Runtime ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Recommended local model: qwen3:4b or mistral-rag
OLLAMA_MODEL=qwen3:4b
# Request timeout in seconds for local model generation
OLLAMA_TIMEOUT=120.0

# ── Groq Cloud Fallback / Web Agent (Optional) ──────────────────────────────
# Required if using LLM_BACKEND=groq or enabling Phase 11 Web Research Agent
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_WEB_MODEL=qwen/qwen3.8-27b

# ── Embeddings & Vector Store ───────────────────────────────────────────────
# HuggingFace model for dense semantic retrieval (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Device: cpu or cuda
EMBEDDING_DEVICE=cpu
# Directory where ChromaDB and BM25 persistent files are saved
CHROMA_PERSIST_DIR=./vectorstore

# ── Observability & Tracing (Optional) ──────────────────────────────────────
# LangSmith tracing for LangGraph agent execution inspection
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=localmind

# ── MCP Authentication (Optional) ──────────────────────────────────────────
MCP_AUTH_TOKEN=change_this_to_a_secure_token

# ── Deployment Flag ─────────────────────────────────────────────────────────
# Set to true in resource-constrained environments (e.g., Hugging Face Spaces)
HF_DEPLOYMENT=false
